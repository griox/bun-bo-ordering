apiVersion: batch/v1
kind: Job
metadata:
  name: ${JOB_NAME}
  namespace: default
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 300
  template:
    spec:
      restartPolicy: Never
      nodeSelector:
        role: apps
      containers:
        - name: migration
          image: ${IMAGE}
          command: ["dotnet", "${DLL}", "--migrate"]
          envFrom:
            - configMapRef:
                name: bunbo-config
            - secretRef:
                name: bunbo-secrets
          env:
            - name: ConnectionStrings__DefaultConnection
              value: "${CONN_STR}"
            - name: JwtSettings__Secret
              valueFrom:
                secretKeyRef:
                  name: bunbo-secrets
                  key: JWT_SECRET
            - name: REDIS_HOST
              valueFrom:
                configMapKeyRef:
                  name: bunbo-config
                  key: Redis__Host
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: bunbo-secrets
                  key: REDIS_PASSWORD
            - name: ConnectionStrings__Redis
              value: "$(REDIS_HOST),password=$(REDIS_PASSWORD),abortConnect=false"
