apiVersion: v1
kind: Secret
metadata:
  name: bunbo-secrets
  namespace: default
type: Opaque
data:
  # Base64 encoded values expected here
  POSTGRES_PASSWORD: "<BASE64_ENCODED_PASSWORD>"
  REDIS_PASSWORD: "<BASE64_ENCODED_PASSWORD>"
  SEPAY_SECRET_KEY: "<BASE64_ENCODED_KEY>"
  SEPAY_API_KEY: "<BASE64_ENCODED_KEY>"
  SEPAY_ACCOUNT_NUMBER: "<BASE64_ENCODED_ACCOUNT>"
  SEPAY_BANK_BIN: "<BASE64_ENCODED_BIN>"
  RABBITMQ_PASSWORD: "<BASE64_ENCODED_PASSWORD>"
  SMTP_SENDER_EMAIL: "<BASE64_ENCODED_EMAIL>"
  SMTP_USERNAME: "<BASE64_ENCODED_USERNAME>"
  SMTP_PASSWORD: "<BASE64_ENCODED_APP_PASSWORD>"
  S3_ACCESS_KEY: "<BASE64_ENCODED_KEY>"
  S3_SECRET_KEY: "<BASE64_ENCODED_KEY>"
